 },
 "kernel_intermediate": [
  {
   "route": "f64",
   "largest partial sum, any order or grouping, with or without fused multiply-add": "n (2^15 - 1)^2 < 2^53 (n = 1536: 2^40.585)",
   "why exact": "every product and every partial sum is an integer below 2^53, and every integer below 2^53 is a float64; a sum or a fused a b + c whose exact value is a float64 is returned exactly"
  },
  {
   "route": "f32",
   "largest partial sum, any order or grouping, with or without fused multiply-add": "1,024 x 128 x 128 = 2^24 within a chunk; the chunks are added in int64",
   "why exact": "every digit product is an integer of magnitude at most 2^14 and every partial sum of a chunk, in any order, is an integer of magnitude at most 2^24; every integer of magnitude at most 2^24 is a float32, so no addition or fused multiply-add rounds. The digits have at most 8 significant bits (|d| <= 128), so they are also exact as TF32 or bfloat16 inputs"
  },
  {
   "route": "i8",
   "kernel intermediate, int16 pair sum": "2 x 255 x 255 = 130,050",
   "why exact": "one uint8 by uint8 product (up to 65,025) does not fit a signed 16-bit lane, so a uint8 by uint8 kernel has to widen before it adds: a pair needs 18 bits, any sum of k products is at most k 255^2 < 2^31 for k <= 33,025. routes_test.py's 'all +max' puts every pair at 130,050 and fails on a kernel that keeps less. uint8 by uint8 is the MatMulInteger type pair every onnxruntime version implements",
   "the digits it replaces": "a1 = a >> 8 (int8), a0 = a & 255 (uint8): a uint8 by int8 kernel without VNNI adds adjacent pairs in int16 with saturation, and 2 x 255 x 128 = 65,280 > 32,767; a 7-bit unsigned digit (2 x 127 x 128 = 32,512) would hold, at six products instead of four. onnxruntime 1.23.2 (macOS x86-64) could not build a MatMulInteger session for one of the pairs with an int8 operand (NOT_IMPLEMENTED)"
  }
 ],
