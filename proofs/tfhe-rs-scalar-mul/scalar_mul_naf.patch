+/// Returns the non-adjacent form (digits in {-1, 0, 1}, no two consecutive non-zero digits)
+/// of the unsigned value whose little endian bits are `bits`.
+///
+/// The output has `bits.len() + 1` digits and represents exactly the same value.
+fn non_adjacent_form(bits: &[u8]) -> Vec<i8> {
+    let mut digits = Vec::with_capacity(bits.len() + 1);
+    let mut carry = 0u8;
+    for i in 0..=bits.len() {
+        let current = bits.get(i).copied().unwrap_or(0) + carry;
+        let next = bits.get(i + 1).copied().unwrap_or(0);
+        match current {
+            0 => {
+                digits.push(0);
+                carry = 0;
+            }
+            1 if next == 1 => {
+                // ...11 = ...00 + 4 - 1
+                digits.push(-1);
+                carry = 1;
+            }
+            1 => {
+                digits.push(1);
+                carry = 0;
+            }
+            _ => {
+                // current == 2
+                digits.push(0);
+                carry = 1;
+            }
+        }
+    }
+    digits
+}
