+#[cfg(test)]
+mod naf_tests {
+    use super::non_adjacent_form;
+
+    #[test]
+    fn test_non_adjacent_form_is_exact_and_non_adjacent() {
+        for value in 0u32..(1 << 12) {
+            let bits = (0..12).map(|i| ((value >> i) & 1) as u8).collect::<Vec<_>>();
+            let digits = non_adjacent_form(&bits);
+            let recomposed: i64 = digits
+                .iter()
+                .enumerate()
+                .map(|(i, &d)| i64::from(d) << i)
+                .sum();
+            assert_eq!(recomposed, i64::from(value));
+            assert!(digits.windows(2).all(|w| w[0] == 0 || w[1] == 0));
+        }
+    }
+}
