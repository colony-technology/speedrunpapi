
(declare-const H Int) (declare-const p Int) (declare-const sExp Int) (declare-const d Int)
(declare-const ne Bool) (declare-const na Bool) (declare-const tz Bool) (declare-const aw Bool) (declare-const odd Bool)
(declare-const after Bool)
(declare-const rpb Bool) (declare-const unbIncr Bool)

(declare-const iHF Bool) (declare-const cHF Bool) (declare-const zHF Bool)
(declare-const iS Bool) (declare-const cS Bool) (declare-const zS Bool)
(declare-const iU Bool) (declare-const cU Bool) (declare-const zU Bool)
(define-fun B () Int (* 2 H))
(define-fun T () Int (+ p 3))
(define-fun m () Int (+ p 1 d))
(define-fun E () Int (- (+ B p 3) sExp))
(define-fun O () Int (- (+ (* 3 B) p 1) sExp))
(define-fun Sq () Int (- (+ B 4) sExp))
(define-fun Ru () Int (+ 2 d))
(define-fun RS () Int (ite (>= Ru Sq) Ru Sq))
(define-fun u () Int (ite (>= sExp 0) sExp (+ sExp (* 4 B))))
(define-fun k0 () Int (- (+ B 2) u))
(define-fun k () Int (ite (< k0 0) 0 (ite (> k0 (+ p 1)) (+ p 1) k0)))
(define-fun RHF () Int (+ 2 (ite (>= d k) d k)))
(define-fun RU () Int Ru)
(assert (>= H 2)) (assert (>= p 3)) (assert (<= p (+ H 3))) (assert (or (= d 0) (= d 1)))
(assert (<= (- (* 4 B)) sExp)) (assert (<= sExp (- (* 4 B) 1)))
(assert (= 1 (+ (ite ne 1 0) (ite na 1 0) (ite tz 1 0) (ite aw 1 0) (ite odd 1 0))))
(assert (=> (> RHF m) iHF))
(assert (=> (and (<= RHF m) (not iHF)) (not cHF)))
(assert (=> (and (<= RHF m) (or tz odd)) (not cHF)))
(assert (=> (>= RHF (+ m 2)) (= zHF (or aw odd))))
(assert (=> (= RHF (+ m 1)) (and (=> tz (not zHF)) (=> (or aw odd) zHF))))
(assert (=> (> RS m) iS))
(assert (=> (and (<= RS m) (not iS)) (not cS)))
(assert (=> (and (<= RS m) (or tz odd)) (not cS)))
(assert (=> (>= RS (+ m 2)) (= zS (or aw odd))))
(assert (=> (= RS (+ m 1)) (and (=> tz (not zS)) (=> (or aw odd) zS))))
(assert (=> (> RU m) iU))
(assert (=> (and (<= RU m) (not iU)) (not cU)))
(assert (=> (and (<= RU m) (or tz odd)) (not cU)))
(assert (=> (>= RU (+ m 2)) (= zU (or aw odd))))
(assert (=> (= RU (+ m 1)) (and (=> tz (not zU)) (=> (or aw odd) zU))))
(assert (=> (= RHF RS) (and (= iHF iS) (= cHF cS) (= zHF zS))))
(assert (=> (and (<= RHF RS) iHF) iS))
(assert (=> (= RHF RU) (and (= iHF iU) (= cHF cU) (= zHF zU))))
(assert (=> (and (<= RHF RU) iHF) iU))
(assert (=> (and (<= RS RHF) iS) iHF))
(assert (=> (= RS RU) (and (= iS iU) (= cS cU) (= zS zU))))
(assert (=> (and (<= RS RU) iS) iU))
(assert (=> (and (<= RU RHF) iU) iHF))
(assert (=> (and (<= RU RS) iU) iS))
(define-fun carryHF () Bool (ite (<= RHF m) cHF zHF))
(define-fun t () Int (ite (<= RHF m) (+ d (ite cHF 1 0)) (ite (= RHF T) (ite zHF 2 0) (ite zHF 1 0))))
(define-fun sRE () Int (+ sExp t))
(define-fun ovfHF () Bool (>= sRE (* 3 B)))
(define-fun tuHF () Bool (<= sRE (- (+ B 3) p)))
(define-fun tiny2 () Bool (> RHF (+ Ru 1)))
(define-fun tiny1 () Bool (> RHF Ru))
(define-fun ufHF () Bool (or tuHF (and iHF (< sExp (* 2 B)) tiny1 (not (and after (not tiny2) carryHF rpb unbIncr)))))
(define-fun ixHF () Bool (or ovfHF tuHF iHF))
(assert (=> (= RHF (+ Ru 1)) (= cU (and rpb carryHF unbIncr))))
(define-fun ovfR () Bool (and (<= RS m) (>= (+ m (ite cS 1 0)) O)))
(define-fun ixR () Bool (or ovfR iS))
(define-fun tinyR () Bool (ite after (< (+ m (ite cU 1 0)) E) (< m E)))
(define-fun ufR () Bool (and tinyR ixR))
(define-fun kHF () Int (ite ovfHF (ite (or ne na aw) 2 3) (ite tuHF (ite (or aw odd) 1 0) 1)))
(define-fun eHF () Int (ite tuHF (- (+ B 3) p) sRE))
(define-fun pow2HF () Bool (or tuHF (ite (<= RHF m) cHF zHF)))
(define-fun kR () Int (ite ovfR (ite (or ne na aw) 2 3) (ite (and (> RS m) (not zS)) 0 1)))
(define-fun topR () Int (ite (<= RS m) (+ m (ite cS 1 0)) RS))
(define-fun eR () Int (+ (- sExp p 1) topR))
(define-fun pow2R () Bool (ite (<= RS m) cS zS))
(assert (not (and (<= (- (* 8 B)) sRE) (< sRE (* 8 B)))))
(check-sat)
(get-model)
