# Lemma L1 for stage 3 (HardFloat lines 233-256, tininess after rounding).
# x has its top bit set (m = N-1). R is marked (one-hot `mark`), 2 <= R <= N; U = R - 1 is the rounding
# position with unbounded exponent (R = U + 1 is the only case where HardFloat consults it).
# Claim: rho(x, U) carries out of the top  <=>  bit R-1 of x  &  bit m+1 of rho(x, R)  &  unbIncr,
# where unbIncr is HardFloat's unboundedRange_roundIncr: ((ne | na) & bit U-1 of x) | (magUp & any bit below U).
# Side A computes the right-hand side as HardFloat does; side B computes the carry from the definition.
length N >= 3
input x, mark : N
input ne, na, tz, aw, odd : bit
assume top(x,0)
assume eq(mark & (mark - 1), 0) & ~bit(mark,0) & ~bit(mark,1)
assume (ne | na | tz | aw | odd)
assume ~(ne & na) & ~(ne & tz) & ~(ne & aw) & ~(ne & odd) & ~(na & tz) & ~(na & aw) & ~(na & odd)
assume ~(tz & aw) & ~(tz & odd) & ~(aw & odd)
# mark = 0 within the word stands for R = N (the mark at the top), allowed: R <= m + 1 = N.

# rounding at R; mark = 0 means R = N: then rho(x, R) is 0 or 2^N
let below = mark - 1
let half = (eq(mark, 0) ? 0 : mark) >> 1
let halfN = eq(mark, 0)
let rem = x & below
let t = x & ~below
let gt = halfN ? lt((below >> 1) + 1, x) : lt(half, rem)
let tie = halfN ? eq(x, (below >> 1) + 1) : eq(rem, half)
let nz = ~eq(rem, 0)
let q_odd = ~eq(t & mark, 0)
let up = (ne & (gt | (tie & q_odd))) | (na & (gt | tie)) | (aw & nz) | (odd & nz & ~q_odd)
let inc = up ? mark : 0
let carryR = halfN ? up : cout(t, inc)

# rounding at U = R - 1
let markU = halfN ? ((below >> 1) + 1) : (mark >> 1)
let belowU = markU - 1
let halfU = markU >> 1
let remU = x & belowU
let tU = x & ~belowU
let gtU = lt(halfU, remU)
let tieU = eq(remU, halfU)
let nzU = ~eq(remU, 0)
let q_oddU = ~eq(tU & markU, 0)
let upU = (ne & (gtU | (tieU & q_oddU))) | (na & (gtU | tieU)) | (aw & nzU) | (odd & nzU & ~q_oddU)
let carryU = cout(tU, upU ? markU : 0)

let roundPosBit = ~eq(x & markU, 0)
let unbIncr = ((ne | na) & ~eq(x & halfU, 0)) | (aw & nzU)
output lhs = carryU
output rhs = roundPosBit & carryR & unbIncr
