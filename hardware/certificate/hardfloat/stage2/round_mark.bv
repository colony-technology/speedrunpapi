# The definition of rounding at a marked position in the contract of round_states.py (the measured anchor):
# letters (bit of x, mark), exactly one marked letter, at position R; y = x rounded to a multiple of 2^R;
# output y_i at letter i, final outputs y_L (the carry out of the word) and inexact.
# The rule is a one-hot scalar input: ne, na (ties away), tz, aw (away from zero), odd.
length N >= 1
input x, mark : N
input ne, na, tz, aw, odd : bit
assume orr(mark) & eq(mark & (mark - 1), 0)
assume (ne | na | tz | aw | odd)
assume ~(ne & na) & ~(ne & tz) & ~(ne & aw) & ~(ne & odd) & ~(na & tz) & ~(na & aw) & ~(na & odd)
assume ~(tz & aw) & ~(tz & odd) & ~(aw & odd)

let ulp = mark
let below = mark - 1
let half = mark >> 1
let rem = x & below
let t = x & ~below
let gt = lt(half, rem)
let tie = eq(rem, half) & ~eq(half, 0)
let nz = ~eq(rem, 0)
let q_odd = ~eq(t & ulp, 0)
let up = (ne & (gt | (tie & q_odd))) | (na & (gt | tie)) | (aw & nz) | (odd & nz & ~q_odd)
let inc = up ? ulp : 0
let y = t + inc

output y
output carry = cout(t, inc)
output inexact = nz
